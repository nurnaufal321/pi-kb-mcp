# Mode B: private single-user HTTP server with self-refresh.
#
# Bigger than the stdio image because it carries headless Chromium: the portal's
# token issuer cannot be called directly, so the only unattended way to mint a
# token is to boot the real SPA and observe it (see NOTES.md).
#
# This image holds YOUR portal session. Never expose it publicly, and always put
# TLS in front of it.
#
# Pinned to bookworm on purpose: Playwright's `install --with-deps` does not yet
# resolve system packages correctly on Debian trixie, which `python:3.12-slim`
# now tracks (libasound2 and friends were renamed with the t64 transition).
FROM python:3.12-slim-bookworm

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/

# Separate steps so a build failure identifies itself rather than hiding behind
# a compound command.
RUN pip install --no-cache-dir '.[serve]'
RUN playwright install-deps chromium
RUN playwright install chromium

# Session cookies live here; mount a volume so they survive redeploys and never
# end up baked into the image.
ENV PI_KB_MCP_COOKIES=/data/cookies.json \
    PI_KB_MCP_SESSION=/data/session.json \
    PORT=8080
VOLUME ["/data"]
EXPOSE 8080

# PI_KB_MCP_SECRET must be supplied at runtime; the server refuses to start
# without one of at least 24 characters.
ENTRYPOINT ["pi-kb-mcp", "serve"]
