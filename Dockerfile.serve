# Mode B: private single-user HTTP server with self-refresh.
#
# Built on Playwright's official image, which ships Chromium and every system
# library it needs. Installing the browser onto a plain python:slim base fails:
# `playwright install --with-deps` cannot resolve packages on Debian trixie
# (the t64 renames), and pinning back to bookworm only moves the problem.
#
# Chromium is here because the portal's token issuer is dead — it returns HTTP
# 500 to every call, WSDL included — so the only unattended way to mint a token
# is to boot the real SPA and read the token off its own request. See NOTES.md.
#
# The image tag and the playwright pin in pyproject.toml must stay in step, or
# the Python client will not match the bundled browser.
FROM mcr.microsoft.com/playwright/python:v1.62.0-noble

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN pip install --no-cache-dir --break-system-packages '.[serve]'

# Session cookies live here; mount a volume so they survive redeploys and never
# end up baked into the image.
ENV PI_KB_MCP_COOKIES=/data/cookies.json \
    PI_KB_MCP_SESSION=/data/session.json \
    PORT=8080
VOLUME ["/data"]
EXPOSE 8080

# PI_KB_MCP_SECRET must be supplied at runtime; the server refuses to start
# without one of at least 24 characters.
ENTRYPOINT ["pi-kb-mcp", "serve"]
